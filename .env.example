NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Edge Function secrets for scheduled training reminder emails.
# Set these with `supabase secrets set`; they are not used by the Next.js app.
RESEND_API_KEY=your-resend-api-key
TRAINING_REMINDER_FROM_EMAIL="Sthenos <training@your-domain.com>"
TRAINING_REMINDER_APP_URL=https://your-production-domain.com
TRAINING_REMINDER_CRON_SECRET=replace-with-a-long-random-secret
TRAINING_REMINDER_EMAILS_ENABLED=false

# TODO: Add Stripe/Vercel/payment provider env vars when billing is introduced.
